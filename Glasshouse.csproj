<Project Sdk="Microsoft.NET.Sdk">
  <!-- Glasshouse (22 Oct 2026): one small exe that installs, edits, saves and repairs the macOS-style desktop.
       .NET Framework 4.8 is built into every Windows 10/11, so the exe runs anywhere with nothing else installed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Glasshouse</AssemblyName>
    <RootNamespace>Glasshouse</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\glasshouse.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Glasshouse</Product>
    <Company>maclanwright</Company>
    <Description>Glasshouse: a macOS-style desktop for Windows 11</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="inspector\capture.ps1" LogicalName="inspector.capture.ps1" />
    <EmbeddedResource Include="inspector\index.html" LogicalName="inspector.index.html" />
    <EmbeddedResource Include="looks\*.glasshouse" />
    <Resource Include="assets\glasshouse-256.png" />
  </ItemGroup>
</Project>
