    {
      "id": "windows-11-taskbar-styler",
      "version": "1.10",
      "include": "explorer.exe",
      "exclude": "",
      "architecture": "x86-64",
      "disabled": false,
      "settings": {
        "clickThroughTaskbar": 0,
        "controlStyles[0].styles[0]": "Visibility=Collapsed",
        "controlStyles[0].target": "SystemTray.SystemTrayFrame",
        "controlStyles[1].styles[0]": "Fill=#B31C1C1E",
        "controlStyles[1].styles[1]": "StrokeThickness=0",
        "controlStyles[1].styles[2]": "Margin=0",
        "controlStyles[1].target": "Taskbar.TaskbarBackground#HoverFlyoutBackgroundControl > Grid > Rectangle#BackgroundFill",
        "controlStyles[2].styles[0]": "Visibility=Collapsed",
        "controlStyles[2].target": "Taskbar.TaskbarBackground#HoverFlyoutBackgroundControl > Grid > Rectangle#BackgroundStroke",
        "controlStyles[3].styles[0]": "Background=Transparent",
        "controlStyles[3].styles[1]": "BorderThickness=0",
        "controlStyles[3].target": "Border#HoverFlyoutBackground",
        "controlStyles[4].styles[0]": "Padding=0,0,0,0",
        "controlStyles[4].styles[1]": "Margin=0",
        "controlStyles[4].target": "ContentPresenter#HoverFlyoutContent",
        "controlStyles[5].styles[0]": "VerticalAlignment=Center",
        "controlStyles[5].styles[1]": "HorizontalAlignment=Center",
        "controlStyles[5].styles[2]": "FontSize=15",
        "controlStyles[5].styles[3]": "FontWeight=SemiBold",
        "controlStyles[5].styles[4]": "Foreground=#F2FFFFFF",
        "controlStyles[5].target": "Taskbar.TaskItemThumbnailView > Grid > TextBlock#DisplayNameTextBlock",
        "controlStyles[6].styles[0]": "Visibility=Collapsed",
        "controlStyles[6].target": "Taskbar.TaskItemThumbnailView > Grid > Microsoft.UI.Xaml.Controls.ItemsRepeater",
        "controlStyles[7].styles[0]": "CornerRadius=11",
        "controlStyles[7].styles[1]": "Margin=0",
        "controlStyles[7].styles[2]": "Background=Transparent",
        "controlStyles[7].styles[3]": "BorderThickness=2.5",
        "controlStyles[7].styles[4]": "BorderBrush=Transparent",
        "controlStyles[7].styles[5]": "Background@PointerOver=#14FFFFFF",
        "controlStyles[7].styles[6]": "BorderBrush@PointerOver=#B3FFFFFF",
        "controlStyles[7].styles[7]": "Background@Pressed=#22FFFFFF",
        "controlStyles[7].styles[8]": "BorderBrush@Pressed=#FFFFFFFF",
        "controlStyles[7].target": "Taskbar.TaskItemThumbnailView > Grid@CommonStates > Border#BackgroundBorder, Taskbar.TaskItemThumbnailView@CommonStates > Grid > Border#BackgroundBorder",
        "controlStyles[8].styles[0]": "Transform3D:=<CompositeTransform3D TranslateX=\"1\" TranslateY=\"44\" />",
        "controlStyles[8].target": "Taskbar.TaskListLabeledButtonPanel#IconPanel > Image#OverlayIcon, Grid#IconPanel > Image#OverlayIcon, Taskbar.TaskListLabeledButtonPanel#IconPanel > Taskbar.Badge#BadgeControl, Grid#IconPanel > Taskbar.Badge#BadgeControl",
        "styleConstants[0]": "",
        "theme": "",
        "themeResourceVariables[0]": "",
